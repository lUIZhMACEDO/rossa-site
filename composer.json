{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "dedoc/scramble": "^0.13.22",
        "doctrine/dbal": "^4.4",
        "guzzlehttp/guzzle": "^7.2",
        "halaxa/json-machine": "^1.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/slack-notification-channel": "^3.10",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "maennchen/zipstream-php": "^3.2",
        "markrogoyski/math-php": "^2.13",
        "wire-elements/modal": "^3.0"
    },
	"require-dev": {
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.10",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.43",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "lint:check": [
            "@php vendor/bin/pint --test"
        ],
        "audit": [
            "@composer audit --no-dev"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "test": [
            "@php artisan test"
        ],
        "security": "semgrep scan --config p/default --config p/php --error",
        "security:new": "semgrep scan --config p/default --config p/php --error --baseline-commit main",
        "check": "bash scripts/check.sh"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.6"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
